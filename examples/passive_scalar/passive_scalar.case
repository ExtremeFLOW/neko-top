{
    "version": 1.0,
    "case":
    {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "end_time": 9.0,
        "timestep": 5e-4,
        "numerics": {
            "time_order": 1,
            "polynomial_order": 5,
            "dealias": true
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0, 0.0, 0.0
                ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1, 3, 4, 5, 6 ]
                },
                {
                     "type": "outflow",
                     "zone_indices": [ 2 ]
                 }
            ]
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 2.0,
            "output_control": "never",
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0, 0.0, 0.0
                ]
            },
            "inflow_condition": {
                "type": "user"
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": "jacobi",
                "projection_space_size": 0,
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": "hsmg",
                "projection_space_size": 0,
                "absolute_tolerance": 1e-4,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [ 1, 0, 0 ],
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [ 3, 4, 5, 6 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2]
                }
            ],
        },
        "scalar": {
            "enabled": true,
            // in the real case we'll be working with a much higher Peclet number
            "Pe": 500.0,
            "solver": {
                "type": "cg",
                "preconditioner": "jacobi",
                "projection_space_size": 0,
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "user",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0,
                    "zone_indices": [2, 3, 4, 5, 6 ]
                },
            ],
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0, 0.0, 0.0
                ]
            }
        },
        "adjoint_scalar": {
            "enabled": true,
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 0,
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0,
                    "zone_indices": [2, 3, 4, 5, 6 ]
                },
            ],
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0, 0.0, 0.0
                ]
            }
        },
     "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [
                    1.0,
                    5.0,
                ],
                "y_bounds": [
                    -1.0,
                     3.0,
                ],
                "z_bounds": [
                    -1.0,
                     3.0,
                ],
           },
            {
                "name": "objective_location",
                "geometry": "box",
                "x_bounds": [
                    5.75,
                    7.0,
                ],
                "y_bounds": [
                    -1.0,
                     3.0,
                ],
                "z_bounds": [
                    -1.0,
                     3.0,
                ],
           },
                 ]
    },
    "optimization": {
        "solver": {
            "type": "mma",
            "max_iterations": 5,
            "tolerance": 1.0e-3,
            "mma": {
                "max_iter": 100,
                "backend": "cuda",
                "asyinit": 0.5,
                "asyincr": 1.2,
                "asydecr": 0.7,
                "m": 1,
                "scale": 1.0,
                "auto_scale": false,
                "xmin": 0.0,
                "xmax": 1.0,
                "a0": 1.0,
                "a": 0.0,
                "c": 100.0,
                "d": 0.0
            }
        },
        "objectives": [
            {
                "type": "scalar_mixing",
                "weight": 1.0,
                "phi_ref": 0.5,
            }
        ],
    },
}
