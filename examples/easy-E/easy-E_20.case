{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_directory": "easy-E_1_fields",
        "output_at_end": false,
        "output_boundary": false,
        "output_checkpoints": false,
        "time": {
            "end_time": 10.0,
            "timestep": 1e-4
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 8,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 2000.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 1.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-8,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "output_control": "nsamples",
            "output_value": 250,
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [ 3, 4, 5, 6 ]
                }
            ],
            "source_terms": [
                {
                    "type": "brinkman",
                    "limits": [ 0.0, 1500.0 ],
                    "penalty": 1.0,
                    "objects": [
                        {
                            "type": "point_zone",
                            "name": "cylinder"
                        },
                        {
                            "type": "point_zone",
                            "name": "ball"
                        }
                    ]
                }
            ]
        },
        "scalar": {
            "enabled": true,
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-8,
                "max_iterations": 800
            },
            "Pe": 2000.0,
            "target_temperature": 20.0,
            "initial_condition": {
                "type": "uniform",
                "value": 0.0
            },
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 0.0,
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 1.0,
                    "zone_indices": [ 2, 3, 4, 5, 6 ]
                }
            ],
            "source_terms": [
                {
                    "type": "user"
                }
            ]
        },
        "point_zones": [
            {
                "name": "cylinder",
                "geometry": "cylinder",
                "start": [ 1.0, 0.5, 0.0 ],
                "end": [ 1.0, 0.5, 0.5 ],
                "radius": 0.10
            },
            {
                "name": "ball",
                "geometry": "sphere",
                "center": [ 1.0, 0.5, 0.5 ],
                "radius": 0.10
            }
        ]
    }
}