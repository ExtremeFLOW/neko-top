{
    "version": 1.0,
    "optimization": {
        "design": {
            "type": "simple",
            "domain": {
                "type": "box",
                "limits": [ 0.0, 10.0, 0.0, 10.0, 0.0, 10.0 ],
                "nx": 10,
                "ny": 10,
                "nz": 10
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 1000,
            "tolerance": 1.0e-9,
            "mma": {
                "max_iter": 100,
                "backend": "cpu",
                "asyinit": 0.5,
                "asyincr": 1.2,
                "asydecr": 0.7,
                "scale": 1.0,
                "auto_scale": false,
                "xmin": 0.00,
                "xmax": 10.0,
                "a0": 1.0,
                "a": 0.0,
                "c": 10000.0,
                "d": 0.0
            }
        }
    }
}
