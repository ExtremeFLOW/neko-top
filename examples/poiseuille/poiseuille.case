{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "end_time": 0.5,
        "timestep": 5e-3,
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 6000,
            "initial_condition": {
                "type": "uniform",
                "value": [0.0, 0.0, 0.0],
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": "jacobi",
                "projection_space_size": 0,
                "absolute_tolerance": 1e-8,
                "max_iterations": 100
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": "hsmg",
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 100
            },
            "output_control": "never",
            "boundary_conditions": [ // these don't actually do anything
                {
                    "type": "no_slip",
                    "zone_indices": [3, 4]
                },
            ],
        },
        "adjoint_fluid": {
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [3, 4] // note these are lin and adj
                },
            ],
        },
    }
}
