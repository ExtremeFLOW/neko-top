{
    "version": 1.0,
    "case": {
        "mesh_file": "immersed_M2.nmsh",
        "output_at_end": false,
        "output_boundary": false,
        "output_checkpoints": false,

        "end_time": 2.0,
        "timestep": 1.00E-03,
        "adapt_timestep": true,
        "max_timestep": 1.00E-03,
        "target_cfl": 0.2,

        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 200,
            "initial_condition": {
                "type": "uniform",
                "value": [ 1.0, 0.0, 0.0 ]
            },
            "inflow_condition": {
                "type": "uniform",
                "value": [
                    1.0
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": "jacobi",
                "projection_space_size": 0,
                "absolute_tolerance": 1e-8,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": "hsmg",
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "output_control": "tsteps",
            "output_value": 1,
            "boundary_types": [
                "v",
                "o+dong",
                "on",
                "on",
            ],
            "source_terms": [
                {
                    "type": "idw",
                    "rmax": 2.0,
                    "power_parameter": 2.0,
                    "one_sided": true,
                    "objects": [
                        {
                            "type": "boundary_mesh",
                            "name": "cylinder.stl",
                            "mesh_transform": {
                                "type": "bounding_box",
                                "box_min": [ -0.5, -0.5, 0.001 ],
                                "box_max": [ 0.5, 0.5, 0.501 ],
                                "keep_aspect_ratio": false
                            }
                        }
                    ]
                }
            ]
        }
    }
}
