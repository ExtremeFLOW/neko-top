{
    "version": 1.0,
    "case": {
        "mesh_file": "ext_cyl.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "time": {
            "end_time": 1.0,
            "timestep": 5e-3
        },
        "numerics": {
            "time_order": 1,
            "polynomial_order": 5,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 100,
            "initial_condition": {
                "type": "field",
                "file_name": "baseflow0.f00000",
                "interpolate": true
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-4,
                "max_iterations": 800
            },
            "output_control": "never",
            "boundary_conditions": [ // these don't actually do anything
                {
                    "type": "no_slip",
                    "zone_indices": [1, 2, 4, 5]
                },
                {
                    "type": "outflow",
                    "zone_indices": [3]
                }
            ],
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0, 0.0, 0.0
                ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [1, 2, 4, 5] // note these are lin and adj
                },
                {
                    "type": "outflow",
                    "zone_indices": [3]
                }
            ],
        },
    }
}
