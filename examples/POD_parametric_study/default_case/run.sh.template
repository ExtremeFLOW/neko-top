#!/bin/bash
set -euo pipefail

if [ -z "${MAIN_DIR:-}" ]; then
    MAIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
fi

source "${MAIN_DIR}/scripts/mpmd_run_helpers.sh"

CASE_DIR=$(pwd)
CASE_FILE=$(mpmd_resolve_case_file "${CASE_DIR}" "${1:-}")
PY_SCRIPT=${2:-"${MAIN_DIR}/scripts/python/pod_state_recover.py"}

NEKO_RANKS=${NEKO_RANKS:-5}
PY_RANKS=${PY_RANKS:-3}

if [ -x "${CASE_DIR}/prepare.sh" ]; then
    ./prepare.sh
fi

if [ -n "${NEKO_BIN:-}" ]; then
    NEKO_EXE="${NEKO_BIN}"
elif [ -x "${MAIN_DIR}/examples/POD_parametric_study/neko" ]; then
    NEKO_EXE="${MAIN_DIR}/examples/POD_parametric_study/neko"
elif [ -x "./neko" ]; then
    NEKO_EXE="./neko"
elif [ -x "../neko" ]; then
    NEKO_EXE="../neko"
else
    echo "Error: no Neko executable found." >&2
    exit 1
fi

CASE_NAME="$(basename "${CASE_FILE}")"
CASE_BASE="${CASE_NAME%.case}"

if mpmd_case_needs_python_driver "${CASE_FILE}"; then
    mpmd_ensure_adios2_python "${MAIN_DIR}"
    LOG_FILE=${LOG_FILE:-"mpmd_${CASE_BASE}.log"}
else
    LOG_FILE=${LOG_FILE:-"neko_${CASE_BASE}.log"}
fi

mpmd_print_runtime_env

if mpmd_case_needs_python_driver "${CASE_FILE}"; then
    mpmd_launch_shared "${CASE_FILE}" "${PY_SCRIPT}" "${NEKO_EXE}" \
        "${PY_RANKS}" "${NEKO_RANKS}" "${LOG_FILE}"
else
    mpmd_launch_neko_only "${CASE_FILE}" "${NEKO_EXE}" \
        "${NEKO_RANKS}" "${LOG_FILE}"
fi
