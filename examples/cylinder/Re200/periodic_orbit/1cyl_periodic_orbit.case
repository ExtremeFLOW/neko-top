{
    "version": 1.0,
    "case": {
        "mesh_file": "newton.nmsh",
        "output_directory": "viz",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": true,
        "time": {
            "end_time": 5.158,
            "timestep": 0.005
        },
        "numerics": {
            "time_order": 1,
            "polynomial_order": 5,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 200.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 1.0, 0.1, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1.0e-8,
                "max_iterations": 20
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "phmg",
                    "pcoarsening_schedule": [ 3, 2, 1 ],
                    "coarse_grid": {
                        "solver": "tamg"
                    }
                },
                "absolute_tolerance": 1.0e-8,
                "max_iterations": 20
            },
            "output_control": "never",
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 2, 4, 5 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 3 ]
                }
            ]
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1, 2, 4, 5 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 3 ]
                }
            ]
        },
        "lightkrylov": {
            "periodic_orbit": {
                "initial_period": 5.158,
                "absolute_tolerance": 1.0e-6,
                "transient_time": 120.0,
                "movie_frames": 32,
                "write_outer_iterations": true,
                "outer_iteration_output_prefix": "outer_periodic_orbit_Re200",
                "movie_output_prefix": "periodic_orbit_Re200_movie"
            }
        }
    },
    "checkpoints": {
        "enabled": false,
        "algorithm": "linear",
        "n_memory": 2048,
        "path": "checkpoints/",
        "filename": "periodic_orbit_forward"
    }
}
