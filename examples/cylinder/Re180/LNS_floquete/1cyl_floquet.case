{
    "version": 1.0,
    "case": {
        "mesh_file": "newton.nmsh",
        "output_directory": "viz",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": true,
        "time": {
            "end_time": 5.2350032253733518,
            "timestep": 0.0075
        },
        "numerics": {
            "time_order": 1,
            "polynomial_order": 5,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 180.0,
            "initial_condition": {
                "type": "field",
                "file_name": "baseflow0.f00000"
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1.0e-4,
                "max_iterations": 20
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "phmg",
                    "pcoarsening_schedule": [ 3, 2, 1 ],
                    "coarse_grid": {
                        "solver": "tamg"
                    }
                },
                "absolute_tolerance": 1.0e-4,
                "max_iterations": 20
            },
            "output_control": "never",
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 2, 4, 5 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 3 ]
                }
            ]
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1, 2, 4, 5 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 3 ]
                }
            ]
        },
        "lightkrylov": {
            "floquet": {
                "period": 0.0,
                "number_of_eigenvalues": 4,
                "krylov_dimension": 24,
                "tolerance": 1.0e-8,
                "movie_frames": 32,
                "write_baseflow_movie": true,
                "write_mode_movies": true,
                "number_of_mode_movies": 4
            }
        }
    },
    "checkpoints": {
        "enabled": false,
        "algorithm": "linear",
        "n_memory": 2048,
        "path": "checkpoints/",
        "filename": "floquet_forward"
    }
}
