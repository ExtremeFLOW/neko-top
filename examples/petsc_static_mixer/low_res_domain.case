{
    "version": 1.0,
    "case": {
        "mesh_file": "data_local/petsc_static_mixer/box.nmsh", //
        "output_directory": "fields",
        "time": {
            "end_time": 1.0,
            "timestep": 5e-4
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 1000.0,
            "initial_condition": {
                "type": "uniform",
                "value": [
                    1.0,
                    0.0,
                    0.0
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": { "type": "jacobi" },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-8,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": { "type": "hsmg" },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "output_control": "nsamples",
            "output_value": 250,
            "boundary_conditions ": [
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [ 3, 4, 5, 6 ]
                }
            ],
            "source_terms": [
                {
                    "type": "brinkman",
                    "objects": [
                        {
                            "type": "boundary_mesh",
                            "name": "data_local/petsc_static_mixer/surface_low_95.stl",
                            "distance_transform": {
                                "type": "smooth_step",
                                "value": 0.1
                            },
                            "mesh_transform": {
                                "type": "bounding_box",
                                "box_min": [ 1.00, 0.00, 0.00 ],
                                "box_max": [ 3.00, 1.00, 1.00 ],
                                "keep_aspect_ratio": true
                            }
                        }
                    ],
                    "brinkman": {
                        "limits": [ 0.0, 100.0 ],
                        "penalty": 1.0
                    }
                }
            ]
        }
    }
}