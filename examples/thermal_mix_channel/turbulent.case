{
    "version": 1.0,
    "case": {
        "mesh_file": "data_local/thermal_mix_channel/square_pipe.nmsh",
        "output_checkpoints": false,
        "output_at_end": true,
        "end_time": 5.0,
        "timestep": 1e-5,
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 3000.0,
            "initial_condition": {
                "type": "uniform",
                "value": [
                    1.0,
                    0.0,
                    0.0
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": "jacobi",
                "absolute_tolerance": 1e-8,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": "hsmg",
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "output_control": "nsamples",
            "output_value": 250,
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [
                        1, 2
                    ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [
                        3
                    ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [
                        4
                    ]
                }
            ]
        },
        "scalar": {
            "enabled": true,
            "Pe": 1000.0,
            "solver": {
                "type": "cg",
                "preconditioner": "jacobi",
                "absolute_tolerance": 1e-8,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 0.0,
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "dirichlet",
                    "value": 1.0,
                    "zone_indices": [ 2 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 3, 4 ]
                }
            ],
            "initial_condition": {
                "type": "uniform",
                "value": 0.0
            }
        }
    }
}