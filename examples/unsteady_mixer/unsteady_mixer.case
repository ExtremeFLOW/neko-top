{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "time": {
            "end_time": 12.0,
            "timestep": 5.0e-4
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": false
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 10.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "fused_cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "user_velocity",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [ 3, 4, 5, 6 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ],
            "output_control": "never",
            "output_format": "vtkhdf"
        },
        "scalar": {
            "enabled": true,
            "Pe": 200.0,
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-6,
                "max_iterations": 50
            },
            "initial_condition": {
                "type": "user"
            },
            "boundary_conditions": [
                {
                    "type": "user_dirichlet",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2, 3, 4, 5, 6 ]
                }
            ]
        },
        "adjoint_scalar": {
            "enabled": true,
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 0.0,
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2, 3, 4, 5, 6 ]
                }
            ],
            "initial_condition": {
                "type": "uniform",
                "value": 0.0
            }
        },
        "adjoint_fluid": {
            "output_control": "never",
            "output_format": "vtkhdf",
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1, 3, 4, 5, 6 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ]
        },
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [ 1.0, 3.0 ],
                "y_bounds": [ 0.0, 1.0 ],
                "z_bounds": [ 0.0, 1.0 ]
            },
            {
                "name": "objective_domain",
                "geometry": "box",
                "x_bounds": [ 3.5, 6.5 ],
                "y_bounds": [ 0.0, 1.0 ],
                "z_bounds": [ 0.0, 1.0 ]
            },
            {
                "name": "asym_IC",
                "geometry": "box",
                "x_bounds": [ 1.0, 2.0 ],
                "y_bounds": [ 0.1, 0.5 ],
                "z_bounds": [ 0.1, 0.5 ]
            }
        ]
    },
    "unsteady": true,
    "checkpoints": {
        "enabled": true,
        "format": "hdf5",
        "n_memory": 300
    },
    "optimization": {
        "design": {
            "type": "brinkman",
            "verbose_design": true,
            "verbose_sensitivity": true,
            "output_format": "vtkhdf",
            "mapping": [
                {
                    "type": "PDE_filter",
                    "r": 0.0625, // 1 Element radius
                    "tol": 1e-15
                },
                {
                    "type": "RAMP",
                    "f_max": 100.0,
                    "q": 3.0,
                    "convex_up": true
                }
            ],
            "initial_distribution": {
                "type": "point_zone",
                "base_value": 0.0,
                "zone_value": 1.0,
                "zone_name": "asym_IC"
            },
            "domain": {
                "type": "point_zone",
                "zone_name": "optimization_domain"
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 200,
            "max_runtime": 171900.0,
            "tolerance": 1.0e-13,
            "mma": {
                "scale": 1.0,
                "asyinit": 0.25,
                "asyincr": 1.3,
                "asydecr": 0.7,
                "xmin": 0.0,
                "xmax": 1.0
            },
            "checkpoint": {
                "interval": 1
            }
        },
        "objectives": [
            {
                "type": "scalar_mixing",
                "mask_name": "objective_domain",
                "phi_ref": 0.5,
                "weight": 1.0
            },
            {
                "type": "viscous_dissipation",
                "weight": 0.1
            },
            {
                "type": "brinkman_dissipation",
                "weight": 0.1
            }
        ]
    }
}
