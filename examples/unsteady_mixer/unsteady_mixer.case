{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "time": {
            "end_time": 6.0,
            "timestep": 5e-3
        },
        "numerics": {
            "time_order": 1,
            "polynomial_order": 5,
            "dealias": false
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 2.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-4,
                "max_iterations": 50
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-4,
                "max_iterations": 50
            },
            "boundary_conditions": [
                {
                    "type": "user_velocity",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [ 3, 4, 5, 6 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ],
            "output_control": "never"
        },
        "scalar": {
            "enabled": true,
            "Pe": 200.0,
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-6,
                "max_iterations": 50
            },
            "initial_condition": {
                "type": "user"
            },
            "boundary_conditions": [
                {
                    "type": "user",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2, 3, 4, 5, 6 ]
                }
            ]
        },
        "adjoint_scalar": {
            "enabled": true,
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 0.0,
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2, 3, 4, 5, 6 ]
                }
            ],
            "initial_condition": {
                "type": "uniform",
                "value": 0.0
            }
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1, 3, 4, 5, 6 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ]
        },
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [ 0.5, 5.5 ],
                "y_bounds": [ -1.0, 3.0 ],
                "z_bounds": [ -1.0, 3.0 ]
            },
            {
                "name": "objective_domain",
                "geometry": "box",
                "x_bounds": [ 5.5, 6.5 ],
                "y_bounds": [ -1.0, 3.0 ],
                "z_bounds": [ -1.0, 3.0 ]
            },
            {
                "name": "asym_IC",
                "geometry": "box",
                "x_bounds": [ 1.0, 2.0 ],
                "y_bounds": [ -1.0, 1.0 ],
                "z_bounds": [ -1.0, 1.0 ]
            }
        ]
    },
    "unsteady": true,
    "checkpoints": {
        "enabled": true,
        "n_memory": 100
    },
    "optimization": {
        "design": {
            "type": "brinkman",
            "mapping": [
                {
                    "type": "PDE_filter",
                    "r": 0.15,
                    "tol": 1e-15
                },
                {
                    "type": "RAMP",
                    "f_max": 100.0,
                    "q": 1.0,
                }
            ],
            "initial_distribution": {
                "type": "point_zone",
                "base_value": 0.0,
                "zone_value": 1.0,
                "zone_name": "asym_IC"
            },
            "domain": {
                "type": "point_zone",
                "zone_name": "optimization_domain"
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 100,
            "tolerance": 1.0e-13,
            "mma": {
                "scale": 100.0,
                "xmin": 0.0,
                "xmax": 1.0
            }
        },
        "objectives": [
            {
                "type": "scalar_mixing",
                "mask_name": "objective_domain",
                "phi_ref": 0.5,
                "weight": 1.0,
                "dealias": false
            },
            {
                "type": "target_dissipation",
                "mask_name": "optimization_domain",
                "target": 1.5,
                "weight": 1.0
            },
            {
                "type": "lube_term",
                "weight": 0.01,
                "dealias_sensitivity": false,
                "dealias_forcing": false,
                "mask_name": "optimization_domain"
            }
        ]
    }
}
