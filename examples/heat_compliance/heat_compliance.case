{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": true,
        "time": {
            "end_time": 1e-5,
            "timestep": 1e-5
        },
        "runtime_statistics": { "enabled": true },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 100.0,
            "initial_condition": {
                "type": "uniform",
                "value": [
                    1.0,
                    0.0,
                    0.0
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-8,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "output_control": "nsamples",
            "output_value": 250,
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 1, 2 ]
                }
            ]
        },
    },
    "optimization": {
        "solver": {
            "type": "mma",
            "max_iterations": 500,
            "tolerance": 1.0e-6,
            "enable_output": true,
            "mma": {
                "max_iter": 1000,
                "subsolver": "dip",
                "asyinit": 0.5,
                "asyincr": 1.2,
                "asydecr": 0.7,
                "scale": 10.0,
                "auto_scale": false,
                "xmin": 0.0,
                "xmax": 1.0,
                "a0": 1.0,
                "a": 0.0,
                "c": 1000.0,
                "d": 10.0
            }
        },
    },
    "mapping": [
                {
                    "type": "PDE_filter",
                    "r": 0.1
                },
                {
                    "type": "SIMP",
                    "f_max": 1,
                    "f_min": 0.001,
                    "p": 3,
                }
    ]


}
