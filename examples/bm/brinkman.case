{
    "version": 1.0,
    "case": {
        "mesh_file": "data_local/brinkman_parameters/immersed_M2.nmsh",
        "output_at_end": false,
        "output_boundary": true,
        "output_checkpoints": false,
        "end_time": 0.01,
        "timestep": 2.50e-03,
        "numerics": {
            "time_order": 3,
            "polynomial_order": 7,
            "dealias": false
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 200,
            "initial_condition": {
                "type": "user",
            },
            "inflow_condition": {
                "type": "uniform",
                "value": [
                    1.0
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": "jacobi",
                "projection_space_size": 0,
                "absolute_tolerance": 1e-8,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": "hsmg",
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "output_control": "simulationtime",
            "output_value": 0.05,
            "boundary_types": [
                "v",
                "o+dong",
                "on",
                "on"
            ],
            "source_terms": [
                {
                    "type": "brinkman",
                    "objects": [
                        {
                            "type": "boundary_mesh",
                            "name": "data/surfaces/cylinder.stl",
                            "distance_transform": {
                                "type": "step",
                                "value": 0.0
                            },
                            "mesh_transform": {
                                "type": "bounding_box",
                                "box_min": [ -0.5, -0.5, 0.001 ],
                                "box_max": [ 0.5, 0.5, 1.001 ],
                                "keep_aspect_ratio": false
                            }
                        }
                    ],
                    "brinkman": {
                        "limits": [ 0.0, 100 ],
                        "penalty": 1.0,
                    },
                    "filter": {
                        "type": "PDE",
                        "radius": 0.05
                    }
                }
            ]
        },
        "point_zones": [
            {
                "name": "cylinder",
                "geometry": "cylinder",
                "start": [
                    0.0,
                    0.0,
                    0.0
                ],
                "end": [
                    0.0,
                    0.0,
                    1.0
                ],
                "radius": 0.5
            }
        ]
    }
}
