{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "time": {
            "end_time": 13.0,
            "timestep": 2.6e-3
        },
        "numerics": {
            "time_order": 1,
            "polynomial_order": 5,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 300.0,
            "initial_condition": {
                "type": "user",
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-4,
                "max_iterations": 50
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "phmg",
                    "pcoarsening_schedule": [3, 1],
                    "coarse_grid":{"solver": "tamg"}
                },
                "absolute_tolerance": 1e-4,
                "max_iterations": 50
            },
            "boundary_conditions": [
                {
                    "type": "user_velocity",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [ 3, 4, 5, 6 ]
                },
                {
                    "type": "outflow+dong",
                    "zone_indices": [ 2 ]
                }
            ],
            "output_control": "never"
            //"output_control": "simulationtime",
            //"output_value": 0.5
        },
        "scalar": {
            "enabled": true,
            "Pe": 300.0,
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-6,
                "max_iterations": 50
            },
            "initial_condition": {
                "type": "user"
            },
            "boundary_conditions": [
                {
                    "type": "user_dirichlet",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2, 3, 4, 5, 6 ]
                }
            ]
        },
        "adjoint_scalar": {
            "enabled": true,
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 0.0,
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2, 3, 4, 5, 6 ]
                }
            ],
            "initial_condition": {
                "type": "uniform",
                "value": 0.0
            }
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1, 3, 4, 5, 6 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ],
            "norm_output_control": "tsteps",
            "norm_output_value": 100.0,
            "norm_output_file": "adjoint_norm.csv"
        },
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [ 0.5, 3.5 ],
                "y_bounds": [ -1.0, 3.0 ],
                "z_bounds": [ -1.0, 3.0 ]
            },
            {
                "name": "objective_domain",
                "geometry": "box",
                "x_bounds": [ 5.0, 6.5 ],
                "y_bounds": [ -1.0, 3.0 ],
                "z_bounds": [ -1.0, 3.0 ]
            },
            {
                "name": "asym_IC",
                "geometry": "box",
                "x_bounds": [ 1.0, 2.0 ],
                "y_bounds": [ -1.0, 1.0 ],
                "z_bounds": [ -1.0, 1.0 ]
            },
            {
                "name": "bars",
                "geometry": "combine",
                "operator": "OR",
                "subsets":[
            {
                "name": "thin_cylinder1",
                "geometry": "cylinder",
                "start": [ 0.5, 0.0, 0.0 ],
                "end": [ 1.0, 2.0, 2.0 ],
                "radius": 0.2
            },
            {
                "name": "thin_cylinder2",
                "geometry": "cylinder",
                "start": [ 2.0, 1.0, -1.0 ],
                "end": [ 2.0, 1.25, 2.5 ],
                "radius": 0.15
            },
            {
                "name": "thick_cylinder",
                "geometry": "cylinder",
                "start": [ 2.5, 2.5, 0.5 ],
                "end": [ 2.5, -0.5, 0.5 ],
                "radius": 0.2
            },
                ],
            },
        ]
    },
    "unsteady": true,
    "state_recovery": {
        "type": "pod",
        "enabled": true,
        "n_memory": 100,
        "batch_size": 10,
        "n_modes": 32,
        "i_stream": 250,
        "dtype": "double",
        "output_reconstruction": false,
        "output_format": "vtkhdf",
        "write_modes": true
    },
    "optimization": {
        "design": {
            "type": "brinkman",
            "dealias": false,
            "verbose_design": true,
            "verbose_sensitivity": true,
            "mapping": [
                {
                    "type": "PDE_filter",
                    "r": 0.05,
                    "tol": 1e-15
                },
                {
                    "type": "RAMP",
                    "q": 10.0,
                    "f_max": 15.0
                }
            ],
            "initial_distribution": {
                "type": "point_zone",
                "base_value": 0.0,
                "zone_value": 1.0,
                "zone_name": "bars"
            },
            "domain": {
                "type": "point_zone",
                "zone_name": "optimization_domain"
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 100,
            "tolerance": 1.0e-13,
            "mma": {
                "scale": 1.0,
                "asyinit": 0.1,
                "asyincr": 1.05,
                "asydecr": 0.65,
                "xmin": 0.0,
                "xmax": 1.0
            },
            "checkpoint": {
                "interval": 1,
                // To see the transient behavior I was copying and pasting
                // the neko executable, mesh and case file into a new folder
                // and restarting from a desired iteration.
                // "file": "checkpoints/optimizer_checkpoint_00001.h5"
            }
        },
        "objectives": [
            {
                "type": "scalar_mixing",
                "mask_name": "objective_domain",
                "start_time": 10.0,
                "weight": 120.0,
            },
            {
                "type": "viscous_dissipation",
                "start_time": 10.0,
                "weight": 15.0
            },
            {
                "type": "brinkman_dissipation",
                "start_time": 10.0,
                "weight": 15.0,
            }
        ]
    }
}
