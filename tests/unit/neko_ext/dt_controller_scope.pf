!> Unit tests for `init_dt_controller` in `neko_ext`.
!!
!! The time-step controller reads its settings relative to the object it is
!! given. Neko-TOP's drivers used to give it the whole case file, so a
!! `case.time.variable_timestep` was never found and the run silently kept a
!! placeholder dt of 1.0. These tests pin that the helper reads `case.time`.
module dt_controller_scope
  use mpi
  use pfunit
  use num_types, only: dp
  use neko, only: neko_init
  use json_module, only: json_file
  use time_step_controller, only: time_step_controller_t
  use neko_ext, only: init_dt_controller

  implicit none

  @TestCase
  type, extends(MPITestCase) :: test_dt_controller_scope_case
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_dt_controller_scope_case

  !> A case file whose `case.time` asks for a variable timestep.
  character(len=*), parameter :: VARIABLE_DT_CASE = &
       '{"case": {"time": {' // &
       '"variable_timestep": true, "target_cfl": 0.5, ' // &
       '"max_timestep": 4.0e-3, "timestep": 1.0e-3, "end_time": 1.0' // &
       '}}}'

  logical :: initialized = .false.

contains

  subroutine setUp(this)
    class(test_dt_controller_scope_case), intent(inout) :: this

    if (initialized) return
    initialized = .true.
    call neko_init()

  end subroutine setUp

  subroutine tearDown(this)
    class(test_dt_controller_scope_case), intent(inout) :: this

  end subroutine tearDown

  !> The helper must hand the controller the `case.time` settings.
  @test(npes=[2])
  subroutine reads_case_time(this)
    class(test_dt_controller_scope_case), intent(inout) :: this
    type(json_file) :: params
    type(time_step_controller_t) :: dt_controller

    call params%initialize()
    call params%load_from_string(VARIABLE_DT_CASE)

    call init_dt_controller(dt_controller, params)

    @assertTrue(dt_controller%is_variable_dt, "variable_timestep")
    @assertEqual(0.5_dp, dt_controller%cfl_trg, "target_cfl")
    @assertEqual(4.0e-3_dp, dt_controller%max_dt, "max_timestep")
    @assertEqual(1.0e-3_dp, dt_controller%init_dt, "timestep")

    call params%destroy()
  end subroutine reads_case_time

  !> Control: the controller given the whole case file, as the drivers used
  !! to do, finds no settings and stays in fixed-timestep mode.
  @test(npes=[2])
  subroutine whole_case_file_is_ignored(this)
    class(test_dt_controller_scope_case), intent(inout) :: this
    type(json_file) :: params
    type(time_step_controller_t) :: dt_controller

    call params%initialize()
    call params%load_from_string(VARIABLE_DT_CASE)

    call dt_controller%init(params)

    @assertFalse(dt_controller%is_variable_dt, "variable_timestep")

    call params%destroy()
  end subroutine whole_case_file_is_ignored

end module dt_controller_scope
