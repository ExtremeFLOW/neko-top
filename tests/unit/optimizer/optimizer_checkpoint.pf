module optimizer_checkpoint
  use mpi
  use pfunit

  use json_module, only: json_file
  use json_utils, only: json_get
  use json_utils_ext, only: json_read_file
  use simulation_m, only: simulation_t
  use design, only: design_t, design_factory
  use problem, only: problem_t
  use optimizer, only: optimizer_t, optimizer_factory
  use neko, only: neko_init, neko_finalize
  use neko_top, only: neko_top_register_types
  use vector, only: vector_t
  use vector_math, only: vector_glsubnorm
  use num_types, only: rp
  use registry, only: neko_registry
  use scratch_registry, only: neko_scratch_registry
  use math, only: NEKO_EPS
  use device, only: DEVICE_TO_HOST
  use comm, only: pe_rank

  implicit none

  @TestCase
  type, extends(MPITestCase) :: test_optimizer_checkpoint
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_optimizer_checkpoint

  logical :: initialized_lock = .false.
contains

  subroutine setUp(this)
    class(test_optimizer_checkpoint), intent(inout) :: this

    if (initialized_lock) return
    initialized_lock = .true.

    call neko_init()
    call neko_top_register_types()

  end subroutine setUp

  subroutine tearDown(this)
    class(test_optimizer_checkpoint), intent(inout) :: this

  end subroutine tearDown

  subroutine finalize_test(this)
    class(test_optimizer_checkpoint), intent(inout) :: this

    if (.not. initialized_lock) return
    initialized_lock = .false.

    call neko_finalize()

  end subroutine finalize_test

  ! ========================================================================== !
  ! Test writing the MMA object to HDF5 file.

  @test(npes=[2])
  subroutine manual_checkpoint(this)
    class(test_optimizer_checkpoint), intent(inout) :: this
    type(json_file) :: parameters, design_parameters

    !> The simulation we are working with
    type(simulation_t), target :: sim
    !> The design type
    class(design_t), allocatable :: des
    !> The problem type
    type(problem_t) :: prob
    !> The optimizer (in this case mma)
    class(optimizer_t), allocatable :: opt

    ! Reference and restored objective and design variables
    real(kind=rp) :: f, f_ref, f_half
    type(vector_t) :: x, x_ref, x_half

    ! Internal variables for the optimizer loop
    integer :: iter, iter0
    logical :: converged

    ! Set test parameters
    integer :: i
    character(len=256) :: msg
    integer, parameter :: max_iter = 12
    real(kind=rp), parameter :: tol = 1.0e-8_rp

    ! ------------------------------------------------------------------------ !
    ! Read the parameters file as the first terminal argument

    ! Read the parameters file
    parameters = json_read_file("checkpoint.case")
    call json_get(parameters, 'optimization.design', design_parameters)

    ! ------------------------------------------------------------------------ !
    ! Initialization of the components

    call sim%init(parameters)
    call design_factory(des, design_parameters, sim)
    call prob%init(parameters, des, sim)
    call optimizer_factory(opt, parameters, prob, des, sim)

    call x%init(des%size())
    call x_ref%init(des%size())
    call x_half%init(des%size())

    ! ------------------------------------------------------------------------ !
    ! Run the optimization and save a checkpoint halfway

    iter0 = 0
    call opt%initialize(prob, des, sim)

    do iter = iter0 + 1, max_iter
       converged = opt%step(iter, prob, des, sim)

       if (iter .eq. max_iter / 2 ) then
          call opt%save_checkpoint(iter, des, .true.)
          call prob%get_objective_value(f_half)
          call des%get_values(x_half)
       end if
    end do

    call prob%get_objective_value(f_ref)
    call des%get_values(x_ref)

    call opt%free()
    call prob%free()
    call des%free()
    call sim%free()
    deallocate(des, opt)

    ! Reset the registries
    call neko_registry%free()
    call neko_scratch_registry%free()

    call neko_registry%init()
    call neko_scratch_registry%init()

    ! ------------------------------------------------------------------------ !
    ! Restore from checkpoint

    call sim%init(parameters)
    call design_factory(des, design_parameters, sim)
    call prob%init(parameters, des, sim)
    call optimizer_factory(opt, parameters, prob, des, sim)

    call opt%load_checkpoint(iter = iter0, design = des)
    call opt%initialize(prob, des, sim)

    ! ------------------------------------------------------------------------ !
    ! Verify that the restored state matches the saved checkpoint
    ! up to numerical precision

    call prob%get_objective_value(f)
    call des%get_values(x)
    call x%copy_from(DEVICE_TO_HOST, sync = .false.)
    call x_half%copy_from(DEVICE_TO_HOST, sync = .true.)

    write(msg, '(A)') "Loaded iteration does not match"
    @assertEqual(max_iter / 2, iter0, trim(msg))
    write(msg, '(A)') "Loaded objective does not match"
    @assertEqual(f_half, f, tol, trim(msg))

    do i = 1, des%size()
       write(msg, '(A,I0)') "Loaded design does not match at index ", i
       @assertEqual(x_half%x(i), x%x(i), NEKO_EPS, trim(msg))
    end do

    ! ------------------------------------------------------------------------ !
    ! Continue optimization from restored state

    do iter = iter0 + 1, max_iter
       converged = opt%step(iter, prob, des, sim)
    end do

    ! ------------------------------------------------------------------------ !
    ! Verify that the restored design matches the original one
    ! up to slightly looser tolerance

    call prob%get_objective_value(f)
    call des%get_values(x)

    write(msg, '(A)') "Final objective does not match original objective"
    @assertEqual(0.0_rp, abs((f_ref - f) / f_ref), tol, trim(msg))
    write(msg, '(A)') "Final design does not match original design"
    @assertEqual(0.0_rp, rmse(x_ref, x), tol, trim(msg))

    ! ------------------------------------------------------------------------ !
    ! Clean up the components

    call x%free()
    call x_ref%free()
    call x_half%free()

    call opt%free()
    call prob%free()
    call des%free()
    call sim%free()

    if (allocated(des)) deallocate(des)
    if (allocated(opt)) deallocate(opt)

  end subroutine manual_checkpoint

  ! ========================================================================== !
  ! Test that restarting through run() (as opposed to the manual step()/
  ! load_checkpoint() sequence above) does not re-log the checkpointed
  ! iteration a second time, and does not re-write the CSV header.
  ! Regression test for two bugs:
  !   1. The pre-loop initial log write in optimizer_run() was re-executed
  !      unconditionally after a restart, appending a duplicate CSV row for
  !      the already-logged checkpoint iteration with design-change values
  !      reset to zero (those fields are not part of the checkpoint),
  !      producing two conflicting rows for the same design iteration.
  !   2. optimizer_init_log() always starts from a fresh csv_file_t, whose
  !      header_is_written flag defaults to false; on a restart this caused
  !      the header to be written a second time, in the middle of the
  !      already-existing log file.

  @test(npes=[2])
  subroutine restart_from_run(this)
    class(test_optimizer_checkpoint), intent(inout) :: this
    type(json_file) :: parameters, design_parameters

    type(simulation_t), target :: sim
    class(design_t), allocatable :: des
    type(problem_t) :: prob
    class(optimizer_t), allocatable :: opt

    logical :: found
    character(len=256) :: msg
    character(len=1024) :: line, header
    integer :: file_unit, ierr, comma_pos, i, j, n_iters, n_dup, n_header_dup
    integer, parameter :: max_rows = 32
    integer :: iters(max_rows)
    real(kind=rp) :: iter_value
    ! Own checkpoint basename, distinct from manual_checkpoint's above, so
    ! the two tests cannot collide on the same checkpoint file regardless of
    ! run order within this suite.
    character(len=*), parameter :: restart_checkpoint_file = &
         'checkpoints/restart_via_run_checkpoint_00002.h5'

    ! ------------------------------------------------------------------------ !
    ! Reset registries in case a prior test in this suite left them dirty

    call neko_registry%free()
    call neko_scratch_registry%free()
    call neko_registry%init()
    call neko_scratch_registry%init()

    ! ------------------------------------------------------------------------ !
    ! Start from a clean slate: 'optimization_data.csv' is the shared default
    ! log filename written by every optimizer instance in this test binary,
    ! and a previous run of this same test would leave its own checkpoint
    ! file behind too. Without this, a repeat `ctest` invocation in the same
    ! build directory either corrupts the row-sequence assertion below with
    ! unrelated leftover rows, or aborts the whole binary via ERROR STOP when
    ! `save_checkpoint` refuses to overwrite an existing checkpoint group.

    if (pe_rank .eq. 0) then
       call execute_command_line('rm -f optimization_data.csv ' // &
            trim(restart_checkpoint_file))
    end if
    call MPI_Barrier(MPI_COMM_WORLD, ierr)

    ! ------------------------------------------------------------------------ !
    ! First run: 2 iterations, with a periodic checkpoint saved at iteration 2

    parameters = json_read_file("checkpoint.case")
    call parameters%update('optimization.solver.max_iterations', 2, found)
    @assertTrue(found, 'optimization.solver.max_iterations not found')
    call parameters%add('optimization.solver.checkpoint.interval', 2)
    call parameters%add('optimization.solver.checkpoint.base', &
         'restart_via_run_checkpoint')
    call json_get(parameters, 'optimization.design', design_parameters)

    call sim%init(parameters)
    call design_factory(des, design_parameters, sim)
    call prob%init(parameters, des, sim)
    call optimizer_factory(opt, parameters, prob, des, sim)

    call opt%run(prob, des, sim)

    call opt%free()
    call prob%free()
    call des%free()
    call sim%free()
    deallocate(des, opt)

    call neko_registry%free()
    call neko_scratch_registry%free()
    call neko_registry%init()
    call neko_scratch_registry%init()

    ! ------------------------------------------------------------------------ !
    ! Second run: restart from the checkpoint saved above and continue past it

    parameters = json_read_file("checkpoint.case")
    call parameters%update('optimization.solver.max_iterations', 4, found)
    @assertTrue(found, 'optimization.solver.max_iterations not found')
    call parameters%add('optimization.solver.restart_file', &
         restart_checkpoint_file)
    call json_get(parameters, 'optimization.design', design_parameters)

    call sim%init(parameters)
    call design_factory(des, design_parameters, sim)
    call prob%init(parameters, des, sim)
    call optimizer_factory(opt, parameters, prob, des, sim)

    call opt%run(prob, des, sim)

    call opt%free()
    call prob%free()
    call des%free()
    call sim%free()
    deallocate(des, opt)

    ! ------------------------------------------------------------------------ !
    ! Verify the log has no duplicate header or iteration rows, and that the
    ! restart actually continued logging (a vacuous pass on an empty/
    ! untouched CSV would silently defeat both checks below).

    if (pe_rank .eq. 0) then
       open(newunit = file_unit, file = 'optimization_data.csv', &
            status = 'old', action = 'read', iostat = ierr)
       write(msg, '(A)') 'Could not open optimization_data.csv'
       @assertEqual(0, ierr, trim(msg))

       read(file_unit, '(A)', iostat = ierr) header ! first line is the header

       n_iters = 0
       n_header_dup = 0
       do
          read(file_unit, '(A)', iostat = ierr) line
          if (ierr .ne. 0) exit

          ! A restart that (re-)writes the header appends it as a second
          ! header line in the middle of the file. Catch that explicitly,
          ! rather than letting the non-numeric text corrupt the iteration
          ! parse below.
          if (trim(line) .eq. trim(header)) then
             n_header_dup = n_header_dup + 1
             cycle
          end if

          comma_pos = index(line, ',')
          if (comma_pos .le. 1) cycle
          read(line(1:comma_pos - 1), *, iostat = ierr) iter_value
          if (ierr .ne. 0) cycle
          if (n_iters .ge. max_rows) exit
          n_iters = n_iters + 1
          iters(n_iters) = nint(iter_value)
       end do
       close(file_unit)

       write(msg, '(A,I0,A)') 'Found ', n_header_dup, ' duplicate header &
       &row(s) in optimization_data.csv (a restart re-wrote the header &
       &into the middle of the already-existing log file)'
       @assertEqual(0, n_header_dup, trim(msg))

       n_dup = 0
       do i = 1, n_iters
          do j = i + 1, n_iters
             if (iters(i) .eq. iters(j)) n_dup = n_dup + 1
          end do
       end do

       write(msg, '(A,I0,A)') 'Found ', n_dup, ' duplicate iteration &
       &row(s) in optimization_data.csv (a restart re-logged an &
       &already-logged iteration)'
       @assertEqual(0, n_dup, trim(msg))

       ! Positive check: the run spans iterations 0..4 (2 from the first
       ! run, continuing to 4 after restart). Without this, a restart that
       ! silently failed to append anything at all -- e.g. because it never
       ! actually restarted, or the loop ran zero iterations -- would still
       ! pass the two checks above vacuously, since "no duplicates" is
       ! trivially true of a file nothing was appended to.
       write(msg, '(A,I0,A)') 'Expected 5 logged iterations (0..4), got ', &
            n_iters, ' -- the restart run may not have appended anything'
       @assertEqual(5, n_iters, trim(msg))
       do i = 0, 4
          write(msg, '(A,I0,A)') 'Missing row for iteration ', i, &
               ' in optimization_data.csv'
          @assertTrue(any(iters(1:n_iters) .eq. i), trim(msg))
       end do
    end if

  end subroutine restart_from_run

  ! ========================================================================== !
  ! Utility function to compute RMSE between two vectors

  function rmse(v1, v2) result(result)
    type(vector_t), intent(in) :: v1, v2
    real(kind=rp) :: result

    result = sqrt(vector_glsubnorm(v1, v2)**2 / real(v1%size(), rp))

  end function rmse

end module optimizer_checkpoint
