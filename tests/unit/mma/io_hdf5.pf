module io_hdf5
  use mpi
  use pfunit
  use hdf5
  use neko_config, only: NEKO_BCKND_DEVICE
  use mma, only: mma_t
  use vector, only: vector_t
  use matrix, only: matrix_t
  use num_types, only: rp, sp, dp
  use neko, only: neko_init
  use comm, only: pe_rank, pe_size, NEKO_COMM, MPI_REAL_PRECISION
  use device, only: device_finalize, HOST_TO_DEVICE, DEVICE_TO_HOST, &
       device_init
  use neko_mpi_types, only: neko_mpi_types_free
  use logger, only: neko_log
  use registry, only: neko_registry
  use scratch_registry, only: neko_scratch_registry
  use vector_math, only: vector_glsc2
  use comm, only:

  implicit none

  @TestCase
  type, extends(MPITestCase) :: test_io_hdf5_case
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_io_hdf5_case

  logical :: initialized = .false.
contains

  subroutine setUp(this)
    class(test_io_hdf5_case), intent(inout) :: this

    if (initialized) return
    initialized = .true.
    call neko_init()

  end subroutine setUp

  subroutine tearDown(this)
    class(test_io_hdf5_case), intent(inout) :: this

    ! if ((NEKO_BCKND_DEVICE .eq. 1)) then
    !    call device_finalize
    ! end if

  end subroutine tearDown

  ! ========================================================================== !
  ! Test writing the MMA object to HDF5 file.

  @test(npes=[2])
  subroutine write_hdf5(this)
    class(test_io_hdf5_case), intent(inout) :: this
    integer :: ierr
    integer :: n, m, i
    type(mma_t) :: obj
    type(vector_t) :: x, read_xold1, read_xold2
    real(kind=rp), allocatable :: a(:), c(:), d(:), xmin(:), xmax(:)
    real(kind=rp) :: a0
    integer :: max_iter

    real(kind=rp) :: epsimin, asyinit, asyincr, asydecr

    character(len=:), allocatable :: bcknd, subsolver

    character(len=256) :: fname
    logical :: file_exists
    integer :: file_unit
    integer(hid_t) :: H5T_NEKO_REAL, str_type, hdferr
    integer(hid_t) :: plist_id, file_id, attr_id, dset_id, filespace, memspace
    integer(hid_t) :: xf_id
    integer(hsize_t), dimension(1) :: ddim, dcount, doffset
    integer :: read_n, read_m
    integer :: read_max_iter
    real(kind=rp) :: read_asyinit, read_asyincr, read_asydecr, read_epsimin
    real(kind=rp) :: read_a0
    real(kind=rp), allocatable :: read_a(:), read_c(:), read_d(:)
    character(len=:), allocatable :: group_name
    character(len=100) :: msg
    integer :: drank, n_accum, n_global

    character(len=12) :: read_bcknd, read_subsolver

    call neko_log%section("Test MMA HDF5 I/O")

    ! ------------------------------------------------------------------------ !
    ! Setup the MMA object and write to HDF5 file

    if (pe_rank .eq. 0) then
       n = 4
    else
       n = 2
    end if
    m = 2

    call MPI_Allreduce(n, n_global, 1, MPI_INTEGER, MPI_SUM, NEKO_COMM%mpi_val, ierr)

    call x%init(n)
    if (pe_rank .eq. 0) then
       x%x = [3.0_rp, 4.0_rp, 5.0_rp, 6.0_rp]
    else
       x%x = [1.0_rp, 2.0_rp]
    end if
    x%x = x%x + real(pe_rank, kind=rp) * 0.01_rp
    call x%copy_from(HOST_TO_DEVICE, sync = .true.)

    allocate(a(m), c(m), d(m), xmin(n), xmax(n))
    a = 0.5_rp
    c = 1.0_rp
    d = 0.0_rp
    xmin = 0.0_rp
    xmax = 1.0_rp
    a0 = 1.0_rp
    max_iter = 10
    epsimin = 1.0e-9_rp
    asyinit = 0.5_rp
    asyincr = 1.2_rp
    asydecr = 0.7_rp

    bcknd = 'cpu'
    subsolver = 'dip'
    call obj%init_from_components(x, n, m, a0, a, c, d, xmin, xmax, &
         max_iter, epsimin, asyinit, asyincr, asydecr, bcknd, subsolver)

    fname = 'mma_test_write.h5'

    call neko_log%message("Writing MMA object to HDF5 file: " // trim(fname))
    call obj%write_hdf5(fname, overwrite = .true.)
    call neko_log%message("Finished writing MMA object to HDF5 file.")

    ! ------------------------------------------------------------------------ !
    ! Read back the data

    ! Initialize reader values
    read_n = -1
    read_m = -1
    read_max_iter = -1
    read_asyinit = -1.0_rp
    read_asyincr = -1.0_rp
    read_asydecr = -1.0_rp
    read_epsimin = -1.0_rp

    read_bcknd = ''
    read_subsolver = ''

    allocate(read_a(m), read_c(m), read_d(m))

    call read_xold1%init(n)
    call read_xold2%init(n)

    ! ------------------------------------------------------------------------ !
    ! Read from HDF5 file

    ! Open file and prepare reading
    call h5open_f(ierr)
    call h5pcreate_f(H5P_FILE_ACCESS_F, plist_id, ierr)
    call h5pset_fapl_mpio_f(plist_id, MPI_COMM_WORLD, &
         MPI_INFO_NULL, ierr)
    call h5fopen_f(trim(fname), H5F_ACC_RDONLY_F, file_id, ierr, &
         access_prp = plist_id)

    ! Assign the correct HDF5 data type based on the neko real kind
    select case (rp)
    case (dp)
       H5T_NEKO_REAL = H5T_NATIVE_DOUBLE
    case (sp)
       H5T_NEKO_REAL = H5T_NATIVE_REAL
    case default
       call neko_error('mma: unsupported real kind for HDF5')
    end select

    ! Read attributes
    ddim(1) = 1
    group_name = '/MMA/Parameters'
    call h5aopen_by_name_f(file_id, group_name, 'n', attr_id, ierr)
    call h5aread_f(attr_id, H5T_NATIVE_INTEGER, read_n, ddim, ierr)
    call h5aclose_f(attr_id, ierr)

    call h5aopen_by_name_f(file_id, group_name, 'm', attr_id, ierr)
    call h5aread_f(attr_id, H5T_NATIVE_INTEGER, read_m, ddim, ierr)
    call h5aclose_f(attr_id, ierr)

    call h5aopen_by_name_f(file_id, group_name, 'max_iter', attr_id, ierr)
    call h5aread_f(attr_id, H5T_NATIVE_INTEGER, read_max_iter, ddim, ierr)
    call h5aclose_f(attr_id, ierr)

    call h5aopen_by_name_f(file_id, group_name, 'asyinit', attr_id, ierr)
    call h5aread_f(attr_id, H5T_NEKO_REAL, read_asyinit, ddim, ierr)
    call h5aclose_f(attr_id, ierr)

    call h5aopen_by_name_f(file_id, group_name, 'asyincr', attr_id, ierr)
    call h5aread_f(attr_id, H5T_NEKO_REAL, read_asyincr, ddim, ierr)
    call h5aclose_f(attr_id, ierr)

    call h5aopen_by_name_f(file_id, group_name, 'asydecr', attr_id, ierr)
    call h5aread_f(attr_id, H5T_NEKO_REAL, read_asydecr, ddim, ierr)
    call h5aclose_f(attr_id, ierr)

    call h5aopen_by_name_f(file_id, group_name, 'epsimin', attr_id, ierr)
    call h5aread_f(attr_id, H5T_NEKO_REAL, read_epsimin, ddim, ierr)
    call h5aclose_f(attr_id, ierr)

    ! Read strings
    call h5aopen_by_name_f(file_id, group_name, 'bcknd', attr_id, ierr)
    call h5aget_type_f(attr_id, str_type, ierr)
    call h5aread_f(attr_id, str_type, read_bcknd, ddim, ierr)
    call h5aclose_f(attr_id, ierr)

    call h5aopen_by_name_f(file_id, group_name, 'subsolver', attr_id, ierr)
    call h5aget_type_f(attr_id, str_type, ierr)
    call h5aread_f(attr_id, str_type, read_subsolver, ddim, ierr)
    call h5aclose_f(attr_id, ierr)

    call h5tclose_f(str_type, ierr)

    ! Read penalty parameters
    ddim(1) = 1
    call h5dopen_f(file_id, '/MMA/a0', dset_id, ierr)
    call h5dread_f(dset_id, H5T_NEKO_REAL, read_a0, ddim, ierr)
    call h5dclose_f(dset_id, ierr)

    ddim(1) = m
    call h5dopen_f(file_id, '/MMA/a', dset_id, ierr)
    call h5dread_f(dset_id, H5T_NEKO_REAL, read_a, ddim, ierr)
    call h5dclose_f(dset_id, ierr)

    call h5dopen_f(file_id, '/MMA/c', dset_id, ierr)
    call h5dread_f(dset_id, H5T_NEKO_REAL, read_c, ddim, ierr)
    call h5dclose_f(dset_id, ierr)

    call h5dopen_f(file_id, '/MMA/d', dset_id, ierr)
    call h5dread_f(dset_id, H5T_NEKO_REAL, read_d, ddim, ierr)
    call h5dclose_f(dset_id, ierr)

    ! Read distributed datasets

    ! Define the sizes and offsets (each pe_rank reads its local n from the global array)
    call MPI_Scan(n, n_accum, 1, MPI_INTEGER, MPI_SUM, NEKO_COMM%mpi_val, ierr)

    dcount(1) = n
    doffset(1) = n_accum - n
    ddim(1) = n_global

    ! Create file and memory space (pe_rank = 1 for 1D arrays)
    call h5screate_simple_f(1, ddim, filespace, ierr)
    call h5screate_simple_f(1, dcount, memspace, ierr)

    ! Dataset transfer property list: MPI collective I/O
    call h5pcreate_f(H5P_DATASET_XFER_F, xf_id, ierr)
    call h5pset_dxpl_mpio_f(xf_id, H5FD_MPIO_COLLECTIVE_F, ierr)

    ! Select hyperslab in the file space for this pe_rank
    call h5sselect_hyperslab_f(filespace, H5S_SELECT_SET_F, doffset, dcount, &
         ierr)

    ! Read xold1
    call h5dopen_f(file_id, '/MMA/xold1', dset_id, ierr)
    call h5dread_f(dset_id, H5T_NEKO_REAL, read_xold1%x, dcount, ierr, &
         file_space_id = filespace, mem_space_id = memspace, xfer_prp = xf_id)
    call h5dclose_f(dset_id, ierr)

    ! Read xold2
    call h5dopen_f(file_id, '/MMA/xold2', dset_id, ierr)
    call h5dread_f(dset_id, H5T_NEKO_REAL, read_xold2%x, dcount, ierr, &
         file_space_id = filespace, mem_space_id = memspace, xfer_prp = xf_id)
    call h5dclose_f(dset_id, ierr)

    ! Close transfer property list and dataspaces
    call h5pclose_f(xf_id, ierr)
    call h5sclose_f(memspace, ierr)
    call h5sclose_f(filespace, ierr)

    ! Close file and property list
    call h5fclose_f(file_id, ierr)
    call h5pclose_f(plist_id, ierr)
    call h5close_f(ierr)

    ! ------------------------------------------------------------------------ !
    ! Check the values read from file

    @assertEqual(m, read_m, message = "m")
    @assertEqual(max_iter, read_max_iter, message = "max_iter")

    @assertEqual(asyinit, read_asyinit, message = "asyinit")
    @assertEqual(asyincr, read_asyincr, message = "asyincr")
    @assertEqual(asydecr, read_asydecr, message = "asydecr")
    @assertEqual(epsimin, read_epsimin, message = "epsimin")

    @assertEqual(trim(bcknd), trim(read_bcknd), message = "bcknd")
    @assertEqual(trim(subsolver), trim(read_subsolver), message = "subsolver")

    @assertEqual(a0, read_a0, message = "a0")
    do i = 1, m
       write(msg, '(A,I0,A)') "(", i, ")"
       @assertEqual(a(i), read_a(i), message = "a" // trim(msg))
       @assertEqual(c(i), read_c(i), message = "c" // trim(msg))
       @assertEqual(d(i), read_d(i), message = "d" // trim(msg))
    end do

    call read_xold1%copy_from(HOST_TO_DEVICE, sync = .false.)
    call read_xold2%copy_from(HOST_TO_DEVICE, sync = .true.)

    do i = 1, n
       write(msg, '(A,I0,A)') "(", i, ")"
       @assertEqual(x%x(i), read_xold1%x(i), message = "xold1" // trim(msg))
       @assertEqual(x%x(i), read_xold2%x(i), message = "xold2" // trim(msg))
    end do

    ! ------------------------------------------------------------------------ !
    ! Clean up

    call x%free()
    call read_xold1%free()
    call read_xold2%free()
    call obj%free()
    deallocate(a, c, d, xmin, xmax)

    ! Delete the file if it exists
    if (pe_rank .eq. 0) then
       open(newunit=file_unit, file=fname, status='old', action='write')
       close(file_unit, status='delete')
    end if

    call neko_log%end_section()
  end subroutine write_hdf5

  ! ========================================================================== !
  ! Test the MMA object restart functionality.

  ! The test should initialize a MMA object. Perform 5 iterations, write the
  ! hdf5 file and do another 5 iterations. Then restart from the hdf5 file and
  ! perform 5 iterations again. The results of each iteration should be the
  ! same.
  !
  ! A good test function would be the following Rosenbrock function:
  ! min  f(x) = sum_{i=1}^n-1 [100 (x_{i+1} - x_i^2)^2 + (1 - x_i)^2]
  ! s.t. g_1(x) = + n   - sum_{i=1}^n x_i^2 <= 0
  ! s.t. g_2(x) = - 0.1 - sum_{i=1}^n x_i^2 <= 0
  !      -1.5 <= x_i <= 1.5

  subroutine rosenbrock(x, f, df)
    type(vector_t), intent(inout) :: x
    real(kind=rp), intent(out) :: f
    type(vector_t), intent(inout), optional :: df
    real(kind=rp) :: ghost_p, ghost_n, f_buffer
    real(kind=rp), allocatable :: f_list(:)
    integer :: rank_p, rank_n
    integer :: request_p, request_n
    integer :: i, ierr

    call x%copy_from(DEVICE_TO_HOST, sync = .true.)

    ! ------------------------------------------------------------------------ !
    ! Communicate ghost points

    rank_p = pe_rank + 1
    rank_n = pe_rank - 1

    ! We need x(i-1) and x(i+1) which might be on a neighbouring process.
    if (pe_rank .gt. 0) then
       call MPI_Irecv(ghost_n, 1, MPI_REAL_PRECISION%mpi_val, rank_n, 0, &
            NEKO_COMM%mpi_val, request_n, ierr)
    end if
    if (pe_rank .lt. pe_size - 1) then
       call MPI_Irecv(ghost_p, 1, MPI_REAL_PRECISION%mpi_val, rank_p, 1, &
            NEKO_COMM%mpi_val, request_p, ierr)
    end if

    if (pe_rank .gt. 0) then
       call MPI_Send(x%x(1), 1, MPI_REAL_PRECISION%mpi_val, rank_n, 1, &
            NEKO_COMM%mpi_val, ierr)
    end if
    if (pe_rank .lt. pe_size - 1) then
       call MPI_Send(x%x(x%size()), 1, MPI_REAL_PRECISION%mpi_val, rank_p, 0, &
            NEKO_COMM%mpi_val, ierr)
    end if

    if (pe_rank .lt. pe_size - 1) then
       call MPI_Wait(request_p, MPI_STATUS_IGNORE, ierr)
    end if
    if (pe_rank .gt. 0) then
       call MPI_Wait(request_n, MPI_STATUS_IGNORE, ierr)
    end if

    ! ------------------------------------------------------------------------ !
    ! Compute function value

    allocate(f_list(x%size()))
    do i = 1, x%size() - 1
       f_list(i) = 100.0_rp * (x%x(i + 1) - x%x(i)**2)**2 + (1.0_rp - x%x(i))**2
    end do

    ! Handle the last entry which needs the ghost value
    i = x%size()
    if (pe_rank .lt. pe_size - 1) then
       f_list(i) = 100.0_rp * (ghost_p - x%x(i)**2)**2 + (1.0_rp - x%x(i))**2
    else
       f_list(i) = 0.0_rp
    end if

    ! Compute function value as the global sum
    f = sum(f_list)
    f_buffer = f
    call MPI_Allreduce(f_buffer, f, 1, MPI_REAL_PRECISION%mpi_val, MPI_SUM, &
         NEKO_COMM%mpi_val, ierr)
    deallocate(f_list)

    ! ------------------------------------------------------------------------ !
    ! Compute gradient if requested
    if (present(df)) then
       do i = 1, x%size()
          if (i .eq. 1 .and. pe_rank .eq. 0) then
             df%x(i) = -400.0_rp * x%x(i) * (x%x(i + 1) - x%x(i)**2) - &
                  2.0_rp * (1.0_rp - x%x(i))
          else if (i .eq. 1) then
             df%x(i) = 200.0_rp * (x%x(i) - ghost_n**2) - &
                  400.0_rp * x%x(i) * (x%x(i + 1) - x%x(i)**2) - &
                  2.0_rp * (1.0_rp - x%x(i))
          else if (i .eq. x%size() .and. pe_rank .eq. pe_size - 1) then
             df%x(i) = 200.0_rp * (x%x(i) - x%x(i - 1)**2)
          else if (i .eq. x%size()) then
             df%x(i) = 200.0_rp * (x%x(i) - x%x(i - 1)**2) - &
                  400.0_rp * x%x(i) * (ghost_p - x%x(i)**2) - &
                  2.0_rp * (1.0_rp - x%x(i))
          else
             df%x(i) = 200.0_rp * (x%x(i) - x%x(i - 1)**2) - &
                  400.0_rp * x%x(i) * (x%x(i + 1) - x%x(i)**2) - &
                  2.0_rp * (1.0_rp - x%x(i))
          end if
       end do

       call df%copy_from(HOST_TO_DEVICE, sync = .true.)
    end if
  end subroutine rosenbrock

  subroutine constraint(x, g, dg)
    type(vector_t), intent(inout) :: x
    type(vector_t), intent(inout) :: g
    type(matrix_t), intent(inout), optional :: dg
    integer :: i, ierr
    real(kind=rp) :: sum_x2

    ! Compute sum_i x_i^2
    sum_x2 = vector_glsc2(x, x)

    call x%copy_from(DEVICE_TO_HOST, sync = .true.)

    g%x(1) = - real(x%size(), kind=rp) - sum_x2
    g%x(2) = 0.1_rp - sum_x2
    if (present(dg)) then
       do i = 1, x%size()
          dg%x(1, i) = - 2.0_rp * x%x(i)
          dg%x(2, i) = - 2.0_rp * x%x(i)
       end do
       call dg%copy_from(HOST_TO_DEVICE, sync = .false.)
    end if
    call g%copy_from(HOST_TO_DEVICE, sync = .true.)
  end subroutine constraint

  @test(npes=[2])
  subroutine restart_mma(this)
    class(test_io_hdf5_case), intent(inout) :: this

    type(vector_t) :: x, x_init, x_50, x_after

    real(kind=rp) :: f
    type(vector_t) :: df, g
    type(matrix_t) :: dg

    type(mma_t) :: optimizer
    integer :: n, m, i, iter
    real(kind=rp), allocatable :: a(:), c(:), d(:), xmin(:), xmax(:)
    real(kind=rp) :: a0
    integer :: max_iter

    character(len=:), allocatable :: bcknd, subsolver, fname
    logical :: file_exists
    integer :: file_unit, ierr

    ! ------------------------------------------------------------------------ !
    ! Setup the MMA object

    if (pe_rank .eq. 0) then
       n = 4
    else
       n = 2
    end if
    m = 2

    call x%init(n)
    call x_50%init(n)
    call x_init%init(n)
    call x_after%init(n)

    if (pe_rank .eq. 0) then
       x_init%x = [0.9_rp, 1.0_rp, 1.1_rp, 1.2_rp]
    else
       x_init%x = [0.9_rp, 1.0_rp]
    end if
    call x_init%copy_from(HOST_TO_DEVICE, sync = .true.)

    allocate(a(m), c(m), d(m), xmin(n), xmax(n))
    a0 = 2.0_rp
    a = 0.0_rp
    c = 1000.0_rp
    d = 10.0_rp

    xmin = -1.5_rp
    xmax = 1.5_rp


    bcknd = 'cpu'
    subsolver = 'dip'

    call optimizer%init_from_components(x_init, n, m, a0, a, c, d, xmin, xmax, &
         bcknd = bcknd, subsolver = subsolver)

    ! Write the initial state, this will help us test the overwrite option
    fname = 'mma_restart_test.h5'
    call optimizer%write_hdf5(fname, overwrite = .true.)

    ! ------------------------------------------------------------------------ !
    ! Run the optimization save halfway and then continue
    max_iter = 10

    f = 0.0_rp
    x = x_init
    call df%init(n)
    call g%init(m)
    call dg%init(m, n)

    ! Run the optimization and save at iteration 5
    do iter = 1, max_iter
       call rosenbrock(x, f, df)
       call constraint(x, g, dg)
       call optimizer%update(iter, x, df, g, dg)

       if (iter .eq. max_iter / 2) then
          call optimizer%write_hdf5(fname, overwrite = .true.)
          x_50 = x
       end if
    end do

    ! Store result after solving all iterations
    x_after = x

    call optimizer%free()

    ! ------------------------------------------------------------------------ !
    ! Now restart from HDF5 file

    call optimizer%init_from_components(x_init, n, m, a0, a, c, d, xmin, xmax, &
         bcknd = bcknd, subsolver = subsolver)
    call optimizer%read(fname)

    x = x_50

    ! Perform 5 iterations again
    do iter = max_iter / 2 + 1, max_iter
       call rosenbrock(x, f, df)
       call constraint(x, g, dg)
       call optimizer%update(iter, x, df, g, dg)
    end do

    ! Check that the result matches the one after 10 iterations
    call x%copy_from(DEVICE_TO_HOST, sync = .false.)
    call x_after%copy_from(DEVICE_TO_HOST, sync = .true.)

    do i = 1, n
       @assertEqual(x%x(i), x_after%x(i), 1.0e-16_rp)
    end do

    call x%free()
    call x_50%free()
    call x_init%free()
    call x_after%free()

    call df%free()
    call g%free()
    call dg%free()
    call optimizer%free()
    deallocate(a, c, d, xmin, xmax)

  end subroutine restart_mma

end module io_hdf5
