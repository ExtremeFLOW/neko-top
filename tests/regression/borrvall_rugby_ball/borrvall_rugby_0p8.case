{
    // ======================================================================
    // Borrvall, T. & Petersson, J. (2003), "Topology optimization of fluids
    // in Stokes flow", Int. J. Numer. Meth. Fluids 41:77-107, Sec. 4.4
    // "A rugby ball", gamma = 0.8 (Table III: 47 iterations, J = 31.75).
    //
    // Paper -> Neko-TOP mapping:
    //   rho_NT = 1 - rho_paper   (Neko-TOP: 0 = fluid, 1 = solid)
    //   q_NT   = 1 / q_paper     (RAMP convexity parameter)
    //   f_min  = 2.5 mu / 100^2  = 2.5e-4  (alpha_under, fluid)
    //   f_max  = 2.5 mu / 0.01^2 = 2.5e4   (alpha_bar, solid), mu = 1
    //   Volume: the paper bounds the fluid volume on the unit square,
    //   int rho_paper <= gamma, i.e. solid >= 1 - gamma. Neko-TOP
    //   normalises by the design-domain area 0.9^2 = 0.81, so the limit
    //   is (1 - gamma) / 0.81 with is_max = false.
    //
    // Only initial_distribution.value and the volume limit depend on
    // gamma; both are (1 - gamma) / 0.81.
    // ======================================================================
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": true,
        "time": {
            // The Brinkman term is explicit: a fully solid design
            // (chi = 2.5e4) is stable up to dt = 3e-5 and diverges at
            // 4e-5, so 2e-5 keeps a margin.
            // Forward solves start from rest and are all steady by t ~ 0.076.
            // The adjoint always runs to end_time but meets the same rate by
            // t ~ 0.03. Sensitivities match those with end_time = 0.3.
            "end_time": 0.105,
            "timestep": 2e-5
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 5,
            "dealias": false
        },
        "adjoint_fluid": {
            // Homogeneous counterpart of the forward velocity BC.
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1, 2, 3, 4 ]
                }
            ]
        },
        "fluid": {
            "scheme": "pnpn",
            "mu": 1.0,
            "rho": 1.0,
            // Stokes flow, as in the paper; also applies to the adjoint.
            "advection": false,
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-8,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-6,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    // Unit upward velocity on all four walls (zones 1-4,
                    // see prepare.sh).
                    "type": "velocity_value",
                    "value": [ 0.0, 1.0, 0.0 ],
                    "zone_indices": [ 1, 2, 3, 4 ]
                }
            ],
            "output_control": "never",
            "output_value": 10
        },
        "simulation_components": [
            {
                // tol = 1e-4: tighter values are not reached because the
                // pressure solver tolerance is 1e-6, and the objective
                // differs from a tol = 1e-7 run by ~1e-11 (relative).
                "type": "steady",
                "tol": 1e-4,
                "log_frequency": 50,
                "compute_control": "tsteps",
                "compute_value": 1
            }
        ],
        "point_zones": [
            {
                // Design domain [0.05, 0.95]^2; the strip outside it is
                // prescribed fluid (paper Fig. 8).
                "name": "design_domain",
                "geometry": "box",
                "x_bounds": [ 0.05, 0.95 ],
                "y_bounds": [ 0.05, 0.95 ],
                "z_bounds": [ -10.0, 10.0 ]
            }
        ]
    },
    "optimization": {
        "design": {
            "type": "brinkman",
            "dealias": false,
            "domain": {
                "type": "point_zone",
                "zone_name": "design_domain"
            },
            "mapping": [
                {
                    // No filter, as in the paper. q follows the paper's
                    // continuation q_paper = 0.01 -> 0.1.
                    "type": "RAMP",
                    "q": [ 100.0, 10.0 ],
                    "q_iterations": 50,
                    "f_min": 2.5e-4,
                    "f_max": 2.5e4
                }
            ],
            "initial_distribution": {
                // Start exactly on the volume limit: the strip outside the
                // design domain is masked to fluid, so this value gives
                // 1 - gamma absolute solid, i.e. the paper's uniform
                // rho_paper = gamma.
                "type": "uniform",
                "value": 0.24691358024691357
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 100,
            // tolerance bounds the MMA KKT residual; the paper's stopping
            // rule (relative change in J < 1e-5 twice) has no equivalent.
            "tolerance": 1.0e-6,
            "mma": {
                "max_iter": 100,
                "asyinit": 0.5,
                "asyincr": 1.2,
                "asydecr": 0.7,
                "scale": 1.0,
                "auto_scale": false,
                "xmin": 0.0,
                "xmax": 1.0,
                "a0": 1.0,
                "a": 0.0,
                "c": 1000.0,
                "d": 10.0
            }
        },
        "objectives": [
            {
                // The two terms sum to the paper's total dissipated power
                // over the whole domain.
                "type": "viscous_dissipation",
                "weight": 1.0
            },
            {
                "type": "brinkman_dissipation",
                "weight": 1.0,
                "dealias_forcing": false,
                "dealias_sensitivity": false
            }
        ],
        "constraints": [
            {
                // Solid fraction >= (1 - gamma) / 0.81, see the header.
                "type": "volume",
                "mask_name": "design_domain",
                "is_max": false,
                "limit": 0.24691358024691357
            }
        ]
    }
}
