# Runtime-only suppressions for clean-exit leak audits in unsteady_mixer.
# These entries target OpenMPI/hwloc/libevent/CUDA initialization allocations
# that persist at process teardown and are outside project ownership.

# Everything allocated while MPI_Init runs is owned by the MPI runtime: ORTE in
# OpenMPI 4 (e.g. Ubuntu 24.04), ompi_mpi_instance_init in OpenMPI 5 (e.g.
# Ubuntu 26.04), and in both the MCA frameworks, hwloc and the transports. The
# entry ends at ompi_mpi_init (not comm_init) so stacks truncated by
# --num-callers still match.
{
   openmpi_mpi_init
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   fun:ompi_mpi_init
}

# hwloc discovers the hardware when MPI starts. Its PCI plugin makes
# libpciaccess load every pci.ids name of each PCI vendor found on the machine
# and keep them until exit, so the still-reachable total depends on the
# hardware of the runner: about 650 KB on a VM that exposes an Intel PCI
# device, a few KB without one (e.g. WSL2). Not owned by the project.
{
   hwloc_topology_load_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:hwloc_topology_load
}

{
   openmpi_libevent_worker
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   fun:event_base_loop
   ...
   fun:start_thread
   fun:clone
}

{
   openmpi_dl_open_worker
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   ...
   fun:call_init*
   fun:_dl_init
   ...
   fun:dl_open_worker*
}

