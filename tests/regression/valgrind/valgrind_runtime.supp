# Runtime-only suppressions for clean-exit leak audits in unsteady_mixer.
# These entries target OpenMPI/hwloc/libevent/CUDA initialization allocations
# that persist at process teardown and are outside project ownership.
#
# The OpenMPI-specific rules below are tuned against OpenMPI 5.0.10's
# PRRTE/PMIx runtime (see `ompi_info --version`). OpenMPI's internal call
# graph has changed across major versions before and may again, so a future
# OpenMPI upgrade re-breaking these is expected, not a regression.

{
   openmpi_ompi_op_init
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   ...
   fun:ompi_op_base_op_select
   fun:ompi_op_init
   ...
   fun:ompi_mpi_init
   ...
   fun:__comm_MOD_comm_init
}

{
   openmpi_pmix_rte_init
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   fun:pmix_rte_init
   ...
   fun:ompi_mpi_init
   ...
   fun:__comm_MOD_comm_init
}

{
   openmpi_mca_framework_open
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   fun:malloc
   ...
   fun:mca_base_framework_open
   ...
   fun:ompi_mpi_init
   ...
   fun:__comm_MOD_comm_init
}

