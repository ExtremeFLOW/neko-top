# Dependency versions
export PFUNIT_VERSION="${PFUNIT_VERSION:-v4.20.0}"
export JSON_FORTRAN_VERSION="${JSON_FORTRAN_VERSION:-9.3.1}"
export NEKO_VERSION="${NEKO_VERSION:-neko-top}"
export HDF5_VERSION="${HDF5_VERSION:-2.2.0}"
export NEK5000_VERSION="${NEK5000_VERSION:-v19.0}"

# Oldest CMake (major.minor) needed to build the pFUnit, JSON-Fortran and HDF5
# versions above, from their cmake_minimum_required, as "<version> <CMake>".
# Each is only checked while its version is the one in use, so update it
# together with the version. Set e.g. PFUNIT_CMAKE_MINIMUM to check another
# minimum instead, whatever the version.
export PFUNIT_CMAKE_PIN="v4.20.0 3.24"
export JSON_FORTRAN_CMAKE_PIN="9.3.1 3.18"
export HDF5_CMAKE_PIN="2.2.0 3.26"
